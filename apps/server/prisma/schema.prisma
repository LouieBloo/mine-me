generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ACCOUNT & PLAYER
// ----------------------------------------------------------------------------
model User {
  id          String      @id @default(cuid())
  phoneNumber String      @unique
  familyName  String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isAdmin     Boolean     @default(false)
  characters  Character[]
}

model Character {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  
  name           String
  class          String    // 'Warrior', 'Mage', 'Rogue'
  profession     String?   // 'Mining', 'Herbalism', etc.
  status         CharacterStatus @default(ACTIVE)
  
  level          Int       @default(1)
  combatScore    Int       @default(10)
  defenseScore   Int       @default(10)
  stamina        Int       @default(100)
  maxStamina     Int       @default(100)
  maxInventorySlots Int    @default(25)
  ageInDays      Int       @default(6570) // ~18 years in days (18 * 365)
  
  sol            Int       @default(0)
  lear           Int       @default(0)
  
  cityId         String
  city           City      @relation(fields: [cityId], references: [id])
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Relationships
  inventory      InventoryItem[]
}

enum CharacterStatus {
  ACTIVE
  DEAD
  RETIRED
}

// ----------------------------------------------------------------------------
// WORLD
// ----------------------------------------------------------------------------
model City {
  id             String          @id @default(cuid())
  name           String          @unique
  description    String
  characters     Character[]
  cityDungeons   CityDungeon[]
  cityMaterials  CityMaterial[]
  backgroundImageUrl String?
  mapIconUrl     String?
  worldPositionX Int     @default(0)
  worldPositionY Int     @default(0)
  objectCoordinates Json?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CityDungeon {
  id         String  @id @default(cuid())
  cityId     String
  city       City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  dungeonId  String
  dungeon    Dungeon @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  orderIndex Int     @default(0)

  @@unique([cityId, dungeonId])
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CityMaterial {
  id     String @id @default(cuid())
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([cityId, itemId])
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Dungeon {
  id             String         @id @default(cuid())
  name           String
  description    String
  minLevel       Int            @default(1)
  levels         DungeonLevel[]
  cityDungeons   CityDungeon[]
  
  completionDropTable DropTable? @relation("DungeonCompletionDrops")
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model DungeonLevel {
  id        String   @id @default(cuid())
  dungeonId String
  dungeon   Dungeon  @relation(fields: [dungeonId], references: [id])
  name      String
  orderIndex Int     @default(0)
  mobs      DungeonLevelMob[]
  
  completionDropTable DropTable? @relation("DungeonLevelCompletionDrops")
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model DungeonLevelMob {
  id              String       @id @default(cuid())
  dungeonLevelId  String
  dungeonLevel    DungeonLevel @relation(fields: [dungeonLevelId], references: [id], onDelete: Cascade)
  mobId           String
  mob             Mob          @relation(fields: [mobId], references: [id])
  
  dropTable       DropTable?   @relation("DungeonLevelMobDrops")
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ----------------------------------------------------------------------------
// ITEMS & INVENTORY
// ----------------------------------------------------------------------------
enum ItemType {
  GEAR
  MATERIAL
  POTION
}

enum ItemRarity {
  LOW
  MEDIUM
  RARE
  VERY_RARE
}

model Item {
  id             String      @id @default(cuid())
  name           String
  description    String
  type           ItemType
  subType        String      @default("")
  vendorBuyPrice Int         @default(0)
  vendorSellPrice Int        @default(0)
  userSellPrice  Int         @default(0)
  userBuyPrice   Int         @default(0)
  rarity         ItemRarity  @default(LOW)
  iconUrl        String?
  gearImageUrl   String?
  isStartingPiece Boolean    @default(false)
  
  dropTableItems DropTableItem[]
  cityMaterials  CityMaterial[]
  inventoryItems InventoryItem[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ----------------------------------------------------------------------------
// DROPS
// ----------------------------------------------------------------------------
model DropTable {
  id              String @id @default(cuid())
  solMin          Int    @default(0)
  solMax          Int    @default(0)
  items           DropTableItem[]

  mobId                 String? @unique
  mob                   Mob?    @relation("MobDrops", fields: [mobId], references: [id], onDelete: Cascade)
  
  dungeonId             String? @unique
  dungeon               Dungeon? @relation("DungeonCompletionDrops", fields: [dungeonId], references: [id], onDelete: Cascade)
  
  dungeonLevelId        String? @unique
  dungeonLevel          DungeonLevel? @relation("DungeonLevelCompletionDrops", fields: [dungeonLevelId], references: [id], onDelete: Cascade)
  
  dungeonLevelMobId     String? @unique
  dungeonLevelMob       DungeonLevelMob? @relation("DungeonLevelMobDrops", fields: [dungeonLevelMobId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model DropTableItem {
  id            String    @id @default(cuid())
  dropTableId   String
  dropTable     DropTable @relation(fields: [dropTableId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  chance        Float     // 0 to 100
  minQuantity   Int       @default(1)
  maxQuantity   Int       @default(1)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model InventoryItem {
  id             String    @id @default(cuid())
  characterId    String
  character      Character @relation(fields: [characterId], references: [id])
  
  itemId         String
  item           Item      @relation(fields: [itemId], references: [id])
  quantity       Int       @default(1)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ----------------------------------------------------------------------------
// MOBS
// ----------------------------------------------------------------------------
model Mob {
  id             String      @id @default(cuid())
  name           String
  level          Int
  health         Int
  attack         Int
  defense        Int
  
  dropTable      DropTable?  @relation("MobDrops")
  
  animations     Json?       // e.g., { idle: { url: '...', frameWidth: 64, frameHeight: 64 } }
  
  dungeonLevelMobs DungeonLevelMob[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
