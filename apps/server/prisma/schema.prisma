generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(cuid())
  phoneNumber String      @unique
  familyName  String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isAdmin     Boolean     @default(false)
  characters  Character[]
}

model Character {
  id                String           @id @default(cuid())
  userId            String
  name              String
  class             String
  profession        String?
  status            CharacterStatus  @default(ACTIVE)
  combatScore       Int              @default(10)
  defenseScore      Int              @default(10)
  health            Int              @default(100)
  maxHealth         Int              @default(100)
  stamina           Int              @default(100)
  maxStamina        Int              @default(100)
  maxInventorySlots Int              @default(25)
  ageInDays         Int              @default(6570)
  experience        Int              @default(0)
  sol               Int              @default(0)
  lear              Int              @default(0)
  cityId            String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  accomplishments   Accomplishment[]
  city              City             @relation(fields: [cityId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
  inventory         InventoryItem[]
}

model City {
  id                 String         @id @default(cuid())
  name               String         @unique
  description        String
  backgroundImageUrl String?
  mapIconUrl         String?
  worldPositionX     Int            @default(0)
  worldPositionY     Int            @default(0)
  objectCoordinates  Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  characters         Character[]
  cityMaterials      CityMaterial[]
}

model CityMaterial {
  id        String   @id @default(cuid())
  cityId    String
  itemId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([cityId, itemId])
}

model Item {
  id              String          @id @default(cuid())
  name            String
  description     String
  type            ItemType
  subType         String          @default("")
  vendorBuyPrice  Int             @default(0)
  vendorSellPrice Int             @default(0)
  userSellPrice   Int             @default(0)
  userBuyPrice    Int             @default(0)
  rarity          ItemRarity      @default(LOW)
  iconUrl         String?
  gearImageUrl    String?
  isStartingPiece Boolean         @default(false)
  experience      Int             @default(0)
  combatScore     Int             @default(0)
  defenseScore    Int             @default(0)
  canBeDamaged    Boolean         @default(false)
  canBeClimbed    Boolean         @default(false)
  throwable       Boolean         @default(false)
  triggerMode     MouseActionTriggerMode @default(SINGLE)
  particleEffectId String?
  particleEffect   ParticleEffect? @relation(fields: [particleEffectId], references: [id], onDelete: SetNull)
  physicsConfig   Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cityMaterials   CityMaterial[]
  dropTableItems  DropTableItem[]
  inventoryItems  InventoryItem[]
  itemEffects     ObjectEffects[]
}

model DropTable {
  id               String          @id @default(cuid())
  solMin           Int             @default(0)
  solMax           Int             @default(0)
  experience       Int             @default(0)
  mobId            String?         @unique
  characterLevelId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  characterLevel   CharacterLevel? @relation("CharacterLevelDrops", fields: [characterLevelId], references: [id], onDelete: Cascade)
  mob              Mob?            @relation("MobDrops", fields: [mobId], references: [id], onDelete: Cascade)
  items            DropTableItem[]
}

model DropTableItem {
  id          String    @id @default(cuid())
  dropTableId String
  itemId      String
  chance      Float
  minQuantity Int       @default(1)
  maxQuantity Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dropTable   DropTable @relation(fields: [dropTableId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  itemId      String
  quantity    Int       @default(1)
  equipped    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id])
  item        Item      @relation(fields: [itemId], references: [id])
}

model Mob {
  id               String     @id @default(cuid())
  name             String
  level            Int
  health           Int
  attack           Int
  defense          Int
  attackPercentage Int        @default(50)
  defendPercentage Int        @default(50)
  animations       Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  dropTable        DropTable? @relation("MobDrops")
}

model Accomplishment {
  id          String             @id @default(cuid())
  characterId String
  type        AccomplishmentType
  referenceId String
  createdAt   DateTime           @default(now())
  character   Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, type, referenceId])
}

model CharacterLevel {
  id         String     @id @default(cuid())
  level      Int        @unique
  xpRequired Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  dropTable  DropTable? @relation("CharacterLevelDrops")
}

model Effect {
  id                  String          @id @default(cuid())
  name                String          @unique
  description         String
  healthGain          Boolean         @default(false)
  staminaGain         Boolean         @default(false)
  miningSpeedModifier Boolean         @default(false)
  explodes            Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  objectEffects       ObjectEffects[]
}

model ObjectEffects {
  id        String   @id @default(cuid())
  itemId    String?
  effectId  String
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  effect    Effect   @relation(fields: [effectId], references: [id], onDelete: Cascade)
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, effectId])
}

model MiningBlock {
  id                   String          @id @default(cuid())
  typeKey              String          @unique
  name                 String
  description          String?
  textureUrl           String?
  mineTimeMs           Int             @default(500)
  staminaCost          Int             @default(1)
  idleParticleEffectId String?
  idleParticleEffect   ParticleEffect? @relation(fields: [idleParticleEffectId], references: [id], onDelete: SetNull)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model MiningMapConfig {
  id                String   @id @default(cuid())
  name              String   @default("Default")
  gridWidth         Int      @default(45)
  gridHeight        Int      @default(45)
  cavernDensity     Int      @default(42)
  cavernIterations  Int      @default(3)
  cavernMinDepth    Int      @default(4)
  tunnelCount       Int      @default(5)
  tunnelMinLength   Int      @default(15)
  tunnelMaxLength   Int      @default(30)
  tunnelWidth       Int      @default(1)
  tunnelMinDepth    Int      @default(2)
  rockPercentage      Int      @default(12)
  mineralPercentage   Int      @default(10)
  chestCount          Int      @default(4)
  copperiumPercentage Int      @default(4)
  silveriumPercentage Int      @default(2)
  silveriumMinDepth   Int      @default(12)
  oreClusterChance    Int      @default(65)
  // Physics & RigidBody Settings
  gravityEnabled      Boolean  @default(true)
  gravity             Float    @default(28.0)
  dynamiteBounciness  Float    @default(0.45)
  dynamiteFriction    Float    @default(0.4)
  dynamiteThrowPower  Float    @default(14.0)
  dynamiteFuseSeconds Float    @default(4.0)
  rockGravityScale    Float    @default(1.2)
  rockRestitution     Float    @default(0.1)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ParticleEffect {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  type         String        @default("CONTINUOUS")
  config       Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        Item[]
  miningBlocks MiningBlock[]
}

enum CharacterStatus {
  ACTIVE
  DEAD
  RETIRED
}

enum ItemType {
  GEAR
  MATERIAL
  CONSUMABLE
}

enum ItemRarity {
  LOW
  MEDIUM
  RARE
  VERY_RARE
}

enum AccomplishmentType {
  DUNGEON_LEVEL_CLEARED
  DUNGEON_CLEARED
}

enum MouseActionTriggerMode {
  SINGLE
  HOLD
}
