generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(cuid())
  phoneNumber String      @unique
  familyName  String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isAdmin     Boolean     @default(false)
  characters  Character[]
}

model Character {
  id                String           @id @default(cuid())
  userId            String
  name              String
  class             String
  profession        String?
  status            CharacterStatus  @default(ACTIVE)
  combatScore       Int              @default(10)
  defenseScore      Int              @default(10)
  health            Int              @default(100)
  maxHealth         Int              @default(100)
  stamina           Int              @default(100)
  maxStamina        Int              @default(100)
  maxInventorySlots Int              @default(25)
  ageInDays         Int              @default(6570)
  experience        Int              @default(0)
  sol               Int              @default(0)
  lear              Int              @default(0)
  cityId            String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  accomplishments   Accomplishment[]
  city              City             @relation(fields: [cityId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
  inventory         InventoryItem[]
}

model City {
  id                 String         @id @default(cuid())
  name               String         @unique
  description        String
  backgroundImageUrl String?
  mapIconUrl         String?
  worldPositionX     Int            @default(0)
  worldPositionY     Int            @default(0)
  objectCoordinates  Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  characters         Character[]
  cityMaterials      CityMaterial[]
}

model CityMaterial {
  id        String   @id @default(cuid())
  cityId    String
  itemId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([cityId, itemId])
}

model Item {
  id              String          @id @default(cuid())
  itemKey         String?         @unique
  name            String
  description     String
  type            ItemType
  subType         String          @default("")
  vendorBuyPrice  Int             @default(0)
  vendorSellPrice Int             @default(0)
  userSellPrice   Int             @default(0)
  userBuyPrice    Int             @default(0)
  rarity          ItemRarity      @default(LOW)
  iconUrl         String?
  gearImageUrl    String?
  inGameSpriteUrl String?
  soundEffectUrl  String?
  soundEffects    Json?
  isStartingPiece Boolean         @default(false)
  experience      Int             @default(0)
  combatScore     Int             @default(0)
  defenseScore    Int             @default(0)
  canBeDamaged    Boolean         @default(false)
  canBeClimbed    Boolean         @default(false)
  throwable       Boolean         @default(false)
  triggerMode     MouseActionTriggerMode @default(SINGLE)
  particleEffectId String?
  particleEffect   ParticleEffect? @relation("ItemGroundParticle", fields: [particleEffectId], references: [id], onDelete: SetNull)
  heldParticleEffectId String?
  heldParticleEffect   ParticleEffect? @relation("ItemHeldParticle", fields: [heldParticleEffectId], references: [id], onDelete: SetNull)
  heldParticleOffsetX Float           @default(0)
  heldParticleOffsetY Float           @default(0)
  heldLightConfig Json?
  physicsConfig   Json?
  lightConfig     Json?
  shootsProjectiles Boolean       @default(false)
  projectileConfig Json?
  inGameScale     Float           @default(1.0)
  holdOffsetX     Float           @default(0)
  holdOffsetY     Float           @default(0)
  holdRotation    Float           @default(0)
  muzzleOffsetX   Float           @default(0)
  muzzleOffsetY   Float           @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cityMaterials   CityMaterial[]
  dropTableItems  DropTableItem[]
  inventoryItems  InventoryItem[]
  itemEffects     ObjectEffects[]
}

model DropTable {
  id               String          @id @default(cuid())
  solMin           Int             @default(0)
  solMax           Int             @default(0)
  experience       Int             @default(0)
  mobId            String?         @unique
  characterLevelId String?         @unique
  miningBlockId    String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  characterLevel   CharacterLevel? @relation("CharacterLevelDrops", fields: [characterLevelId], references: [id], onDelete: Cascade)
  mob              Mob?            @relation("MobDrops", fields: [mobId], references: [id], onDelete: Cascade)
  miningBlock      MiningBlock?    @relation("MiningBlockDrops", fields: [miningBlockId], references: [id], onDelete: Cascade)
  items            DropTableItem[]
}

model DropTableItem {
  id          String    @id @default(cuid())
  dropTableId String
  itemId      String
  chance      Float
  minQuantity Int       @default(1)
  maxQuantity Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dropTable   DropTable @relation(fields: [dropTableId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  itemId      String
  quantity    Int       @default(1)
  equipped    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id])
  item        Item      @relation(fields: [itemId], references: [id])
}

model Mob {
  id               String     @id @default(cuid())
  name             String
  level            Int
  health           Int
  defense          Int
  attackPercentage Int        @default(50)
  defendPercentage Int        @default(50)
  aiType           String     @default("CHASE_AND_MINE")
  aiConfig         Json?
  abilities        Json?
  moveSpeed        Float      @default(3.0)
  jumpForce        Float      @default(6.5)
  hitStunMs        Int        @default(250)
  stunImmunityMs   Int        @default(500)
  animations       Json?
  /// Per-slot sound references: { dig: { soundId, loop? }, idle, damage, attack, death }
  soundEffects     Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  dropTable        DropTable? @relation("MobDrops")
  mobEffects       ObjectEffects[]
}

model Accomplishment {
  id          String             @id @default(cuid())
  characterId String
  type        AccomplishmentType
  referenceId String
  createdAt   DateTime           @default(now())
  character   Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, type, referenceId])
}

model CharacterLevel {
  id         String     @id @default(cuid())
  level      Int        @unique
  xpRequired Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  dropTable  DropTable? @relation("CharacterLevelDrops")
}

model Effect {
  id                  String          @id @default(cuid())
  name                String          @unique
  description         String
  healthGain          Boolean         @default(false)
  staminaGain         Boolean         @default(false)
  miningSpeedModifier Boolean         @default(false)
  damageModifier      Boolean         @default(false)
  toolDamageModifier  Boolean         @default(false)
  pickPowerModifier   Boolean         @default(false)
  knockbackModifier   Boolean         @default(false)
  explodes            Boolean         @default(false)
  // Sets flammable things alight (value = ignition strength in percent, 100 = the material's own chance)
  ignites             Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  objectEffects       ObjectEffects[]
}

model ObjectEffects {
  id        String   @id @default(cuid())
  itemId    String?
  mobId     String?
  effectId  String
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  effect    Effect   @relation(fields: [effectId], references: [id], onDelete: Cascade)
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mob       Mob?     @relation(fields: [mobId], references: [id], onDelete: Cascade)

  @@unique([itemId, effectId])
  @@unique([mobId, effectId])
}

model MiningBlock {
  id                   String          @id @default(cuid())
  typeKey              String          @unique
  name                 String
  description          String?
  textureUrl           String?
  soundEffectUrl       String?
  // How loud the mining sound is on this block, 0 to 1
  soundEffectVolume    Float    @default(1)
  health               Int             @default(100)
  requiredPickPower    Int             @default(0)
  staminaCost          Int             @default(1)
  idleParticleEffectId String?
  idleParticleEffect   ParticleEffect? @relation(fields: [idleParticleEffectId], references: [id], onDelete: SetNull)
  // Shared Flammability shape (null = the block does not burn)
  flammability         Json?
  dropTable            DropTable?      @relation("MiningBlockDrops")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model Fluid {
  id              String   @id @default(cuid())
  // Open key, e.g. OIL. Fluids are rows, not code: a new fluid needs no new enum value.
  typeKey         String   @unique
  name            String
  description     String?
  // CSS hex colour the client draws the fluid with
  color           String   @default("#000000")
  opacity         Float    @default(0.9)
  // Heavier fluids sink under lighter ones, and decide how things float
  density         Float    @default(1)
  // Fraction of movement speed removed at full submersion, 0 to 1
  viscosity       Float    @default(0.5)
  // Share of the level difference moved per simulation step, 0 to 1
  flowRate        Float    @default(0.5)
  // A cell below this level evaporates
  minLevel        Float    @default(0.05)
  // A cell only spreads sideways when the level difference exceeds this
  flowThreshold   Float    @default(0.02)
  // How it looks: waves, highlight and depth shading (shared FluidAppearance shape; null = defaults)
  appearance      Json?
  // Shared Flammability shape (null = not flammable)
  flammability    Json?
  // Where it appears in generated mines (shared FluidGeneration shape; null = never generated)
  generation      Json?
  // Sound slots (enter, exit, ignite, burn): library sounds by id, each with its own volume
  soundEffects    Json?
  // What touching it does to a body: damage per second, ignites, extinguishes (shared FluidContactEffects shape; null = nothing)
  contact         Json?
  // Light the fluid gives off all the time (shared ItemLightConfig shape; null = no glow)
  light           Json?
  // How it reacts with other fluids, e.g. water hardens lava into a block (shared FluidReaction list; null = none)
  reactions       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Gas {
  id               String   @id @default(cuid())
  // Open key, e.g. HYDROGEN. Gases are rows, not code: a new gas needs no new enum value.
  typeKey          String   @unique
  name             String
  description      String?
  // CSS hex colour the client draws the gas with
  color            String   @default("#cccccc")
  // Opacity at full concentration
  opacity          Float    @default(0.5)
  // Relative to air = 1: below 1 the gas rises, above 1 it sinks
  density          Float    @default(1)
  // Share of a cell's gas shared with open neighbours per simulation step, 0 to 1
  diffusionRate    Float    @default(0.25)
  // A cell below this concentration is dropped
  minConcentration Float    @default(0.02)
  // Seconds gas lingers (still rising) in open-to-sky cells before it fades and despawns
  ventLifetime     Float    @default(6)
  // How it looks: edge softness and drift (shared GasAppearance shape; null = defaults)
  appearance       Json?
  // Shared Flammability shape (null = inert)
  flammability     Json?
  // Where it appears in generated mines (shared GasGeneration shape; null = never generated)
  generation       Json?
  // Sound slots (enter, exit, ignite, explode, vent): library sounds by id, each with its own volume
  soundEffects     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MiningMapConfig {
  id                String   @id @default(cuid())
  name              String   @default("Default")
  gridWidth         Int      @default(45)
  gridHeight        Int      @default(45)
  cavernDensity     Int      @default(42)
  cavernIterations  Int      @default(3)
  cavernMinDepth    Int      @default(4)
  tunnelCount       Int      @default(5)
  tunnelMinLength   Int      @default(15)
  tunnelMaxLength   Int      @default(30)
  tunnelWidth       Int      @default(1)
  tunnelMinDepth    Int      @default(2)
  rockPercentage      Int      @default(12)
  mineralPercentage   Int      @default(10)
  chestCount          Int      @default(4)
  copperiumPercentage Int      @default(4)
  silveriumPercentage Int      @default(2)
  silveriumMinDepth   Int      @default(12)
  oreClusterChance    Int      @default(65)
  // Physics & RigidBody Settings
  gravityEnabled      Boolean  @default(true)
  gravity             Float    @default(28.0)
  dynamiteBounciness  Float    @default(0.45)
  dynamiteFriction    Float    @default(0.4)
  dynamiteThrowPower  Float    @default(14.0)
  dynamiteFuseSeconds Float    @default(4.0)
  rockGravityScale    Float    @default(1.2)
  rockRestitution     Float    @default(0.1)
  // Fall damage (players): (impactSpeed - minSpeed) * perSpeed, capped at max (0 = no cap)
  fallDamageMinSpeed  Float    @default(11)
  fallDamagePerSpeed  Float    @default(6)
  fallDamageMax       Float    @default(80)
  // Falling rock damage (players): (rockSpeed - minSpeed) * perSpeed, capped at max (0 = no cap)
  rockDamageMinSpeed  Float    @default(6)
  rockDamagePerSpeed  Float    @default(5)
  rockDamageMax       Float    @default(80)
  // Fire (players and mobs): burning does burnDamagePerSecond for burnSeconds after the last touch of fire;
  // standing within heatRadius tiles of a fire hurts by heatDamagePerSecond x the fire's heat, fading with distance
  burnDamagePerSecond Float    @default(6)
  burnSeconds         Float    @default(5)
  heatRadius          Float    @default(2.5)
  heatDamagePerSecond Float    @default(1.5)
  // ParticleEffect drawn on a burning player or mob (null = none)
  burningEffectId     String?
  // Hostile NPC / Mob Spawning Settings
  mobSpawnCount       Int      @default(3)
  mobSpawnMinDepth    Int      @default(5)
  allowedMobIds       Json?
  // Mob that stands on the surface as a target dummy; null means none
  surfaceDummyMobId   String?  @default("mob_target_dummy")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ParticleEffect {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  type         String        @default("CONTINUOUS")
  config       Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        Item[]          @relation("ItemGroundParticle")
  heldByItems  Item[]          @relation("ItemHeldParticle")
  miningBlocks MiningBlock[]
}

enum CharacterStatus {
  ACTIVE
  DEAD
  RETIRED
}

enum ItemType {
  GEAR
  MATERIAL
  CONSUMABLE
  CURRENCY
}

enum ItemRarity {
  LOW
  MEDIUM
  RARE
  VERY_RARE
}

enum AccomplishmentType {
  DUNGEON_LEVEL_CLEARED
  DUNGEON_CLEARED
}

enum MouseActionTriggerMode {
  SINGLE
  HOLD
}

enum SoundType {
  BGM
  SFX
}

/// Where a sound is used. Music is `type = BGM`; sound effects are grouped by what plays them.
enum SoundCategory {
  GENERAL
  ITEM
  BLOCK
  MOB
  CHARACTER
  FLUID
  GAS
}

/// The player character's sounds (hurt, jump...). One row (id "default"); `soundEffects` maps a slot to a library sound id.
model CharacterSoundConfig {
  id           String   @id @default("default")
  soundEffects Json?
  updatedAt    DateTime @updatedAt
}

model Sound {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        SoundType @default(BGM)
  category    SoundCategory @default(GENERAL)
  url         String
  fileName    String
  fileSize    Int       @default(0)
  mimeType    String    @default("audio/mpeg")
  volume      Float     @default(1.0)
  loop        Boolean   @default(true)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
